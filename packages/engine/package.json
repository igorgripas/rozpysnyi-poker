{
  "name": "@poker/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Детермінований рушій правил розписного покера",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "simulate": "tsx --conditions=source scripts/simulate.ts",
    "compat:fixture": "tsx scripts/compat-fixture.ts",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0"
  }
}
