{
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["done", "blocked"] },
    "completed": {
      "type": "array",
      "items": { "type": "integer" },
      "description": "Номери повністю виконаних issues"
    },
    "summary": { "type": "string", "description": "Markdown-список змін українською" },
    "blocked_reason": { "type": "string" },
    "followups": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": { "title": { "type": "string" }, "body": { "type": "string" } },
        "required": ["title", "body"]
      }
    }
  },
  "required": ["status", "summary"]
}
