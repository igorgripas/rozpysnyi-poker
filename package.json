{
  "name": "rozpysnyi-poker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm -r --if-present e2e",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm rules-coverage && pnpm test && pnpm simulate && pnpm benchmark && pnpm build",
    "rules-coverage": "node scripts/rules-coverage.mjs",
    "simulate": "pnpm --filter @poker/engine simulate",
    "benchmark": "pnpm --filter @poker/bots benchmark",
    "replay": "tsx packages/engine/scripts/replay.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
